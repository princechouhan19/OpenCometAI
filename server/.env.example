# ────────────────────────────────────────────────────────────────────────────
# OpenComet-SIH server — environment configuration template
# Copy this file to `.env` and fill in the values you want to use.
# ────────────────────────────────────────────────────────────────────────────

# Port the server listens on (default 8787)
PORT=8787
HOST=0.0.0.0

# ── Pick ONE backend ──────────────────────────────────────────────────────────

# Option A: OpenAI (cloud)
OPENAI_API_KEY=

# Option B: Anthropic Claude (cloud)
ANTHROPIC_API_KEY=

# Option C: Google Gemini (cloud)
GEMINI_API_KEY=

# Option D: Ollama (local — fully offline — RECOMMENDED for SIH judging)
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI-compatible alternative providers (cloud) ─────────────────────────
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
# Set to 1 to enable verbose request logging
DEBUG=0
